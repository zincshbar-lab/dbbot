# Copy to .env and fill in. Never commit .env.

TELEGRAM_BOT_TOKEN=123456789:AA...

# Admin Telegram user ids (comma-separated). Admins can open the admin panel and
# grant/revoke access for other users. Find your id with @userinfobot.
ADMIN_TELEGRAM_IDS=123456789

# Long random secret used to encrypt each user's stored private key (AES-256-GCM).
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
ENCRYPTION_SECRET=

NEAR_RPC_URLS=https://free.rpc.fastnear.com,https://near.drpc.org
ROUTER_URL=https://router.intear.tech
DATA_DIR=./data
