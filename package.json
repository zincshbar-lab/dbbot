{
  "name": "near-trading-bot",
  "version": "1.0.0",
  "description": "Multi-user NEAR trading Telegram bot: per-user wallets, manual trading, positions/PnL, meme.cooking presales, admin access control.",
  "private": true,
  "type": "module",
  "engines": { "node": ">=22" },
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/index.ts",
    "start": "node --env-file-if-exists=.env dist/index.js",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "grammy": "^1.46.0",
    "near-api-js": "^5.1.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^22.20.4",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  }
}
